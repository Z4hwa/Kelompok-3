Function Main
    Declare Real jarak
    Declare Real efesiensi
    Declare Integer hargaBBM
    Declare Integer pilihan
    Declare Real totalJarak
    Declare Real konsumsiBBM
    Declare Real biayaBBM

    Output "masukkan jarak perjalanan (km):"
    Input jarak
    Output "masukkan efesiensi kendaraan (km/liter):"
    Input efesiensi
    Output "masukkan hargaBBM per liter"
    Input hargaBBM
    Output "Pilih Jenis perjalanan:    1.Sekali jalan  2.Pulang pergi"
    Input pilihan
    If pilihan = 1
        Assign totalJarak = Jarak
    Else
        If pilihan = 2
            Assign totalJarak = Jarak*2
        Else
            Output "Tidak terdaftar"
        End
    End
    Assign konsumsiBBM = totalJarak/efesiensi
    Assign biayaBBM = konsumsiBBM*hargaBBM
End
