<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Flowchart-Travel Coast Calculator"/>
        <attribute name="authors" value="ASUS"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-16 06:17:09 PM"/>
        <attribute name="created" value="QVNVUztMQVBUT1AtRUNWS1IwTEU7MjAyNi0wOS0xMDswNjo1ODo0OSBQTTsyNjkz"/>
        <attribute name="edited" value="QVNVUztMQVBUT1AtRUNWS1IwTEU7MjAyNi0wOS0xNjswNjoxNzowOSBQTTs0OzI4MDE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="jarak" type="Real" array="False" size=""/>
            <declare name="efesiensi" type="Real" array="False" size=""/>
            <declare name="hargaBBM" type="Integer" array="False" size=""/>
            <declare name="pilihan" type="Integer" array="False" size=""/>
            <declare name="totalJarak" type="Real" array="False" size=""/>
            <declare name="konsumsiBBM" type="Real" array="False" size=""/>
            <declare name="biayaBBM" type="Real" array="False" size=""/>
            <output expression="&quot;masukkan jarak perjalanan (km):&quot;" newline="True"/>
            <input variable="jarak"/>
            <output expression="&quot;masukkan efesiensi kendaraan (km/liter):&quot;" newline="True"/>
            <input variable="efesiensi"/>
            <output expression="&quot;masukkan hargaBBM per liter&quot;" newline="True"/>
            <input variable="hargaBBM"/>
            <output expression="&quot;Pilih Jenis perjalanan:    1.Sekali jalan  2.Pulang pergi&quot;" newline="True"/>
            <input variable="pilihan"/>
            <if expression="pilihan = 1">
                <then>
                    <assign variable="totalJarak" expression="Jarak"/>
                </then>
                <else>
                    <if expression="pilihan = 2">
                        <then>
                            <assign variable="totalJarak" expression="Jarak*2"/>
                        </then>
                        <else>
                            <output expression="&quot;Tidak terdaftar&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="konsumsiBBM" expression="totalJarak/efesiensi"/>
            <assign variable="biayaBBM" expression="konsumsiBBM*hargaBBM"/>
        </body>
    </function>
</flowgorithm>
